# ============================================
# QQ Chat Robot - 配置文件模板
# 复制为 .env 并填入你的信息
# ============================================

# --- NoneBot2 核心配置 ---
HOST=127.0.0.1
PORT=8080
SUPERUSERS=["你的QQ号"]

# --- OneBot v11 适配器 ---
# 与 NapCatQQ OneBot 配置中的 token 保持一致
ONEBOT_ACCESS_TOKEN=你的Token

# --- 图片分类插件 ---
# 目标群号 (JSON数组，留空监听所有群)
TARGET_GROUPS=[群号1, 群号2]
# 动漫分类阈值 (0-1)，越高越严格
ANIME_THRESHOLD=0.7
# YOLO 模型路径
YOLO_MODEL_PATH=models/yolov8n-cls.pt
# GPU 推理 (无 GPU 改为 false)
USE_GPU=true
# 图片保存目录
IMAGE_SAVE_DIR=data/images
# 保留天数 (0=永久)
RETENTION_DAYS=0
# --- LLM 聊天插件 ---
# DeepSeek API Key (从 https://platform.deepseek.com 获取)
DEEPSEEK_API_KEY=sk-xxxxxxxx
# API 地址 (可换为其他 OpenAI 兼容接口)
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名称
DEEPSEEK_MODEL=deepseek-chat
# 角色扮演系统提示词 (设定角色和回复规则)
LLM_SYSTEM_PROMPT=你是一个友好的QQ群聊助手，请自然地参与群聊讨论。如果消息与你无关或你不想插话，只回复 [SKIP]。如果要回应，请简练自然地回复。
# LLM 启用的群号 (JSON数组，留空监听所有群)
LLM_TARGET_GROUPS=[群号1, 群号2]
# 对话历史窗口大小 (条数)
LLM_MAX_HISTORY=20
# 生成温度 (0-2)，越高越随机
LLM_TEMPERATURE=0.8
# 最大回复 Token 数
LLM_MAX_TOKENS=512
# 日志级别
LOG_LEVEL=INFO
