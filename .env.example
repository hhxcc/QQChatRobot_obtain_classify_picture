# ============================================
# QQ Chat Robot - 配置文件模板
# 复制为 .env 并填入你的信息
# ============================================

# --- NoneBot2 核心配置 ---
HOST=127.0.0.1
PORT=8080
SUPERUSERS=["你的QQ号"]

# --- OneBot v11 适配器 ---
# 与 SnowLuma 的「WS 客户端」节点中填写的 access_token 保持一致
# (SnowLuma 作为 WS 客户端主动连接本机 8080)
ONEBOT_ACCESS_TOKEN=你的Token

# --- 图片分类插件 ---
# 目标群号 (JSON数组，留空监听所有群)
TARGET_GROUPS=[群号1, 群号2]
# 动漫分类阈值 (0-1)，越高越严格
ANIME_THRESHOLD=0.7
# YOLO 模型路径
YOLO_MODEL_PATH=models/yolov8n-cls.pt
# GPU 推理 (无 GPU 改为 false)
USE_GPU=true
# 图片保存目录
IMAGE_SAVE_DIR=data/images
# 保留天数 (0=永久)
RETENTION_DAYS=0
# --- LLM 聊天插件 ---
# DeepSeek API Key (从 https://platform.deepseek.com 获取)
DEEPSEEK_API_KEY=sk-xxxxxxxx
# API 地址 (可换为其他 OpenAI 兼容接口)
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名称
DEEPSEEK_MODEL=deepseek-chat
# 角色扮演系统提示词 (设定角色和回复规则)
LLM_SYSTEM_PROMPT=你是一个友好的QQ群聊助手，请自然地参与群聊讨论。如果消息与你无关或你不想插话，只回复 [SKIP]。如果要回应，请简练自然地回复。
# 系统提示词文件路径（优先级高于 LLM_SYSTEM_PROMPT，适合长文本）
LLM_SYSTEM_PROMPT_FILE=人格提示词.txt
# Few-shot 对话风格示例文件（可选，追加到系统提示词末尾）
LLM_FEW_SHOT_FILE=knowledge/对话风格示例.txt
# LLM 启用的群号 (JSON数组，留空监听所有群)
LLM_TARGET_GROUPS=[群号1, 群号2]
# 对话历史窗口大小 (条数)
LLM_MAX_HISTORY=20
# 生成温度 (0-2)，越高越随机
LLM_TEMPERATURE=0.8
# 最大回复 Token 数
LLM_MAX_TOKENS=512
# 单次 LLM 请求超时（秒）与网络类异常重试次数（应对校园网/弱网抖动）
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
# 日志级别
LOG_LEVEL=INFO

# --- LLM 聊天插件 (DeepSeek) ---
# 从 https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=你的APIKey
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 系统提示词 (留空则使用下方文件路径)
LLM_SYSTEM_PROMPT=
LLM_SYSTEM_PROMPT_FILE=人格提示词.txt
LLM_FEW_SHOT_FILE=knowledge/对话风格示例.txt
LLM_TARGET_GROUPS=[群号1, 群号2]
LLM_MAX_HISTORY=20
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=512
LLM_COOLDOWN_BASE=8
LLM_COOLDOWN_CEILING=60
LLM_BUFFER_MAX=15

# --- LLM 聊天插件 - 视觉功能 (看图说话) ---
# 视觉功能总开关（/vision on|off 可动态切换；false=默认关闭）
LLM_VISION_ENABLED=true
# 视觉模型 Provider（解耦：glm | ollama | qwen | openai | none）
VISION_PROVIDER=glm
# 智谱开放平台 API Key（https://open.bigmodel.cn）
VISION_API_KEY=你的智谱APIKey
# 视觉模型名（未来换模型只改这里）
VISION_MODEL=glm-4v-flash
# API 地址
VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 视觉 API 超时（秒）
VISION_TIMEOUT=15
#
# 【可选】切换本地 Ollama 视觉（细节/图上文字/分类更好，离线、免 API Key）
#   前提：本机 Ollama 已拉取多模态模型（如 qwen3.5:4B）。走原生 /api/chat。
#   切回云端只需把下方 VISION_PROVIDER 改回 glm 并填好 Key/地址。
#   VISION_PROVIDER=ollama
#   VISION_MODEL=qwen3.5:4B
#   VISION_BASE_URL=http://localhost:11434     # 远程 Ollama 填其地址
#   VISION_TIMEOUT=120                          # 本地冷启动较慢,放宽超时
#   VISION_API_KEY=                             # 本地无需 Key（留空即可）
#
# 注: 8G 显存下 qwen3.5:4B 约占 7.3G,与 YOLO(CUDA) 共存需留意显存。
# 本地预筛
VISION_CLIP_ENABLED=true
VISION_CLIP_THRESHOLD=0.6
# CLIP 模型路径（本地优先，不存在时回退在线加载）
VISION_CLIP_MODEL_PATH=models/clip-vit-base-patch32
VISION_OCR_ENABLED=true
# 触发策略
VISION_REPLY_ON_AT=true
VISION_REPLY_ON_TEXT_IMG=true
VISION_REPLY_ON_IMAGE_ONLY=true
# 同一张图缓存秒数（TTL 内不重复调 API，省成本）
VISION_CACHE_TTL=3600

# --- LLM 聊天插件 - 长期记忆 ---
# 总开关（记录群友发言并持久化到 sqlite，重启不丢）
LLM_MEMORY_ENABLED=true
# 记忆数据库文件路径
MEMORY_DB_PATH=data/memory.db
# 蒸馏模型（解耦，可与聊天模型不同；API Key 留空则复用 DEEPSEEK_API_KEY）
MEMORY_PROVIDER=deepseek
MEMORY_BASE_URL=
MEMORY_API_KEY=
MEMORY_MODEL=deepseek-chat
# 每人累积多少条消息触发一次蒸馏（消息量触发）
MEMORY_DISTILL_THRESHOLD=30
# 定时兜底蒸馏间隔（秒）
MEMORY_DISTILL_INTERVAL=1800

# --- LLM 聊天插件 - 联网搜索 ---
# 总开关（Function Calling 按需搜索，搜不到时机器人如实说"查不到"）
LLM_WEB_SEARCH_ENABLED=true
# 默认搜索方式（模型也可调用其他引擎函数）：bing | duckduckgo | baidu
SEARCH_ENGINE=bing
# 每个搜索函数最多返回条数
SEARCH_RESULT_COUNT=5
# 单次搜索超时（秒）
SEARCH_TIMEOUT=8
# 搜索缓存 TTL（秒）：同类问题短时间不重复搜
SEARCH_CACHE_TTL=300
