# ============================================
# QQ Chat Robot - 配置文件模板
# 复制为 .env 并填入你的信息
# ============================================

# --- NoneBot2 核心配置 ---
HOST=127.0.0.1
PORT=8080
SUPERUSERS=["你的QQ号"]

# --- OneBot v11 适配器 ---
# 与 NapCatQQ OneBot 配置中的 token 保持一致
ONEBOT_ACCESS_TOKEN=你的Token

# --- 图片分类插件 ---
# 目标群号 (JSON数组，留空监听所有群)
TARGET_GROUPS=[群号1, 群号2]
# 动漫分类阈值 (0-1)，越高越严格
ANIME_THRESHOLD=0.7
# YOLO 模型路径
YOLO_MODEL_PATH=models/yolov8n-cls.pt
# GPU 推理 (无 GPU 改为 false)
USE_GPU=true
# 图片保存目录
IMAGE_SAVE_DIR=data/images
# 保留天数 (0=永久)
RETENTION_DAYS=0
# 日志级别
LOG_LEVEL=INFO
